#!/usr/bin/env bash
# setup-waydroid — Restore Waydroid configuration from dotfiles repo
#
# This script restores a complete Waydroid setup including:
#   - Kernel modules (ashmem_linux, binder_linux)
#   - Waydroid configuration (waydroid.cfg, waydroid.prop, waydroid_base.prop)
#   - LXC container configuration
#   - User data dir creation (environment/config only, no app data backup)
#   - Systemd service
#
# Usage: sudo setup-waydroid [--images-only] [--config-only] [--dry-run]

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
WAYDROID_REPO_DIR="$REPO_ROOT/system/waydroid"

say()  { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!! %s\033[0m\n' "$*"; }
die()  { printf '\033[1;31m## %s\033[0m\n' "$*" >&2; exit 1; }

[ -d "$WAYDROID_REPO_DIR" ] || die "Waydroid config not found in repo at $WAYDROID_REPO_DIR"

IMAGES_ONLY=0
CONFIG_ONLY=0
DRYRUN=0

for arg in "$@"; do
  case "$arg" in
    --images-only) IMAGES_ONLY=1 ;;
    --config-only) CONFIG_ONLY=1 ;;
    --dry-run) DRYRUN=1 ;;
    *) die "Unknown option: $arg" ;;
  esac
done

if [ "$EUID" -ne 0 ]; then
  die "This script must be run as root (sudo)."
fi

TARGET_USER="${SUDO_USER:-$USER}"
TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
TARGET_UID="$(id -u "$TARGET_USER")"
TARGET_GID="$(id -g "$TARGET_USER")"

[ -n "$TARGET_HOME" ] && [ -d "$TARGET_HOME" ] || die "Cannot resolve home for user '$TARGET_USER'."

do_cmd() {
  if [ "$DRYRUN" = 1 ]; then
    echo "[dry-run] $*"
  else
    eval "$@"
  fi
}

say "Setting up Waydroid for user: $TARGET_USER (UID: $TARGET_UID)"

# ---------------------------------------------------------------------------
# 1. Install Waydroid and dependencies
# ---------------------------------------------------------------------------
if [ "$CONFIG_ONLY" = 0 ]; then
  say "1/7  Installing Waydroid packages..."
  do_cmd dnf -y install waydroid lxc python3-libselinux
fi

# ---------------------------------------------------------------------------
# 2. Load kernel modules (ashmem, binder)
# ---------------------------------------------------------------------------
if [ "$CONFIG_ONLY" = 0 ]; then
  say "2/7  Configuring kernel modules..."
  do_cmd modprobe ashmem_linux 2>/dev/null || warn "ashmem_linux module not available (may be built-in)"
  do_cmd modprobe binder_linux 2>/dev/null || warn "binder_linux module not available (may be built-in)"
  do_cmd 'echo "ashmem_linux" > /etc/modules-load.d/waydroid.conf'
  do_cmd 'echo "binder_linux" >> /etc/modules-load.d/waydroid.conf'
fi

# ---------------------------------------------------------------------------
# 3. Deploy Waydroid configuration files
# ---------------------------------------------------------------------------
say "3/7  Deploying Waydroid configuration..."

do_cmd "mkdir -p /var/lib/waydroid"
do_cmd "cp -a $WAYDROID_REPO_DIR/lib/waydroid/waydroid.cfg /var/lib/waydroid/waydroid.cfg"
do_cmd "cp -a $WAYDROID_REPO_DIR/lib/waydroid/waydroid.prop /var/lib/waydroid/waydroid.prop"
do_cmd "cp -a $WAYDROID_REPO_DIR/lib/waydroid/waydroid_base.prop /var/lib/waydroid/waydroid_base.prop"

# Update waydroid.prop with current user info
if [ "$DRYRUN" = 0 ]; then
  sed -i "s|waydroid.host.user=.*|waydroid.host.user=$TARGET_USER|" /var/lib/waydroid/waydroid.prop
  sed -i "s|waydroid.host.uid=.*|waydroid.host.uid=$TARGET_UID|" /var/lib/waydroid/waydroid.prop
  sed -i "s|waydroid.host.gid=.*|waydroid.host.gid=$TARGET_GID|" /var/lib/waydroid/waydroid.prop
  sed -i "s|waydroid.host_data_path=.*|waydroid.host_data_path=$TARGET_HOME/.local/share/waydroid/data|" /var/lib/waydroid/waydroid.prop
fi

# LXC configuration
do_cmd "mkdir -p /var/lib/waydroid/lxc/waydroid"
do_cmd "cp -a $WAYDROID_REPO_DIR/lxc/waydroid/config /var/lib/waydroid/lxc/waydroid/config"
do_cmd "cp -a $WAYDROID_REPO_DIR/lxc/waydroid/config_nodes /var/lib/waydroid/lxc/waydroid/config_nodes"
do_cmd "cp -a $WAYDROID_REPO_DIR/lxc/waydroid/config_session /var/lib/waydroid/lxc/waydroid/config_session"
do_cmd "cp -a $WAYDROID_REPO_DIR/lxc/waydroid/waydroid.seccomp /var/lib/waydroid/lxc/waydroid/waydroid.seccomp"

# Update config_session with correct user path
if [ "$DRYRUN" = 0 ]; then
  sed -i "s|/home/ldzbeta/.local/share/waydroid/data|$TARGET_HOME/.local/share/waydroid/data|g" /var/lib/waydroid/lxc/waydroid/config_session
  sed -i "s|/run/user/1000/wayland-1|/run/user/$TARGET_UID/wayland-0|g" /var/lib/waydroid/lxc/waydroid/config_session
  sed -i "s|/run/user/1000/pulse/native|/run/user/$TARGET_UID/pulse/native|g" /var/lib/waydroid/lxc/waydroid/config_session
fi

# host-permissions (empty dir but needed)
do_cmd "mkdir -p /var/lib/waydroid/host-permissions"

# ---------------------------------------------------------------------------
# 4. User data dir (env only — no app data restore)
# ---------------------------------------------------------------------------
if [ "$CONFIG_ONLY" = 0 ]; then
  say "4/7  Setting up user data directory (environment only)..."
  do_cmd "mkdir -p $TARGET_HOME/.local/share/waydroid/data"
  do_cmd "chown -R $TARGET_UID:$TARGET_GID $TARGET_HOME/.local/share/waydroid"
fi

# ---------------------------------------------------------------------------
# 5. Initialize Waydroid images (download if missing)
# ---------------------------------------------------------------------------
if [ "$CONFIG_ONLY" = 0 ]; then
  say "5/7  Initializing Waydroid images..."
  if [ ! -f /var/lib/waydroid/images/system.img ] || [ ! -f /var/lib/waydroid/images/vendor.img ]; then
    say "  Android images not found, downloading via 'waydroid init'..."
    do_cmd "waydroid init -s GAPPS -f"
  else
    say "  Images already exist, skipping download."
  fi
fi

# ---------------------------------------------------------------------------
# 6. Set up binder devices permissions
# ---------------------------------------------------------------------------
if [ "$CONFIG_ONLY" = 0 ]; then
  say "6/7  Configuring binder device permissions..."
  do_cmd "mkdir -p /dev/binderfs"
  do_cmd "mount -t binder binder /dev/binderfs 2>/dev/null || true"
  for dev in binder vndbinder hwbinder; do
    do_cmd "chmod 666 /dev/binderfs/$dev 2>/dev/null || true"
  done
  do_cmd 'echo "binder /dev/binderfs binder defaults 0 0" > /etc/fstab.d/waydroid-binder 2>/dev/null || true'
fi

# ---------------------------------------------------------------------------
# 7. Enable and start Waydroid container service
# ---------------------------------------------------------------------------
if [ "$CONFIG_ONLY" = 0 ] && [ "$IMAGES_ONLY" = 0 ]; then
  say "7/7  Enabling Waydroid container service..."
  do_cmd "systemctl daemon-reload"
  do_cmd "systemctl enable --now waydroid-container.service"
  say "Waiting for container to start..."
  sleep 5
  do_cmd "systemctl status waydroid-container.service --no-pager -l" || warn "Service status check failed"
fi

say "Waydroid setup complete!"
echo ""
echo "Next steps:"
echo "  1. Start Waydroid:  waydroid show-full-ui"
echo "  2. Check logs:      journalctl -u waydroid-container -f"
echo "  3. Access shell:    waydroid shell"
echo ""
echo "To update user data backup in the future, run:"
echo "  ./system/usr/local/bin/backup-waydroid"