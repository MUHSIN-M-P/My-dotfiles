[Unit]
Description=Share clipboard history after window close (Wayland)
Documentation=https://github.com/Linus789/wl-clip-persist
After=wayland-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wl-clip-persist --clipboard regular
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
