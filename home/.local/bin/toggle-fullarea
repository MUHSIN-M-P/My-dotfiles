#!/usr/bin/env python3
import subprocess
import json
import sys
import os
import time

DEBOUNCE_FILE = "/tmp/fullarea_debounce"

def is_debounced():
    now = time.time()
    if os.path.exists(DEBOUNCE_FILE):
        try:
            with open(DEBOUNCE_FILE, "r") as f:
                last_time = float(f.read().strip())
                if (now - last_time) < 0.35:
                    return True
        except Exception:
            pass
    try:
        with open(DEBOUNCE_FILE, "w") as f:
            f.write(str(now))
    except Exception:
        pass
    return False

def get_active_window():
    try:
        res = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=1)
        data = json.loads(res.stdout)
        if isinstance(data, dict) and data.get("address"):
            return data
    except Exception:
        pass
    return None

def get_monitor_reserved():
    try:
        res = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=1)
        data = json.loads(res.stdout)
        if data and isinstance(data, list):
            return data[0].get("reserved", [0, 0, 0, 0])
    except Exception:
        pass
    return [0, 0, 0, 0]

def toggle():
    if is_debounced():
        return

    active = get_active_window()
    if not active:
        return

    fs = active.get("fullscreen", 0)
    reserved = get_monitor_reserved()
    top_bar_hidden = (reserved[1] == 0)

    # If currently maximized or top bar is hidden, go OUT of full area:
    if fs == 1 or top_bar_hidden:
        subprocess.run(["hyprctl", "dispatch", "fullscreenstate", "0", "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["noctalia", "msg", "bar-show"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        # Otherwise go INTO full area (Super+F maximize view without app fullscreen, and hide top bar):
        subprocess.run(["noctalia", "msg", "bar-hide"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["hyprctl", "dispatch", "fullscreenstate", "1", "0"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    toggle()
