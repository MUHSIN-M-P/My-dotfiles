#!/usr/bin/env bash
# sysupdate — Universal update script with desktop notifications

set -euo pipefail

say() {
    printf "\n\033[1;36m==> %s\033[0m\n" "$*"
}

notify() {
    if command -v notify-send >/dev/null; then
        notify-send -a "System Update" -i system-software-update "$@"
    fi
}

notify "Update Status" "System update started..."

# Detect Package Manager
if command -v dnf5 >/dev/null; then
    PKG_MGR="dnf5"
    UPDATE_CMD="sudo dnf5 upgrade -y"
elif command -v dnf >/dev/null; then
    PKG_MGR="dnf"
    UPDATE_CMD="sudo dnf upgrade -y"
elif command -v pacman >/dev/null; then
    if command -v yay >/dev/null; then
        PKG_MGR="yay"
        UPDATE_CMD="yay -Syu"
    elif command -v paru >/dev/null; then
        PKG_MGR="paru"
        UPDATE_CMD="paru -Syu"
    else
        PKG_MGR="pacman"
        UPDATE_CMD="sudo pacman -Syu"
    fi
elif command -v apt-get >/dev/null; then
    PKG_MGR="apt"
    UPDATE_CMD="sudo apt-get update && sudo apt-get dist-upgrade -y"
else
    say "No supported package manager detected."
    notify "Update Status" "Failed: No supported package manager found."
    exit 1
fi

say "Using package manager: $PKG_MGR"
eval "$UPDATE_CMD"

# Flatpak update
if command -v flatpak >/dev/null; then
    say "Updating Flatpaks..."
    flatpak update -y
fi

say "System update completed successfully!"
notify "Update Status" "System update completed successfully!"
