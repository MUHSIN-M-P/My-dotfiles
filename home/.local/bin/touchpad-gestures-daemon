#!/usr/bin/env python3
import subprocess
import re
import time
import sys
import os
import threading
import socket
import json

def log(msg):
    log_file = "/tmp/gesture_debug.log"
    with open(log_file, "a") as f:
        f.write(f"{time.strftime('%H:%M:%S')} - {msg}\n")

def adjust_volume(direction):
    if os.environ.get("NOCTALIA_SESSION") == "v5":
        sign = "+" if direction == "up" else "-"
        subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"3%{sign}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.run(["noctalia", "msg", f"volume-{direction}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def sync_bar_state():
    try:
        res_w = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=1)
        data = json.loads(res_w.stdout)
        is_fs = False
        if isinstance(data, dict) and data.get("address"):
            is_fs = (data.get("fullscreen", 0) != 0)

        res_m = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=1)
        mon = json.loads(res_m.stdout)
        bar_hidden = False
        if mon and isinstance(mon, list):
            bar_hidden = (mon[0].get("reserved", [0, 0, 0, 0])[1] == 0)

        if is_fs and not bar_hidden:
            subprocess.run(["noctalia", "msg", "bar-hide"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif not is_fs and bar_hidden:
            subprocess.run(["noctalia", "msg", "bar-show"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        log(f"sync_bar_state error: {e}")

def socket2_sync_listener():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    hypr_dir = os.path.join(runtime_dir, "hypr")
    
    while True:
        try:
            instance_sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
            if not instance_sig and os.path.exists(hypr_dir):
                dirs = [d for d in os.listdir(hypr_dir) if os.path.isdir(os.path.join(hypr_dir, d))]
                if dirs:
                    instance_sig = dirs[0]

            sock_path = os.path.join(hypr_dir, instance_sig, ".socket2.sock")
            if not os.path.exists(sock_path):
                time.sleep(2)
                continue

            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(sock_path)
            log(f"Connected to socket2: {sock_path}")
            buffer = ""
            while True:
                data = sock.recv(4096).decode('utf-8', errors='ignore')
                if not data:
                    break
                buffer += data
                while "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    line = line.strip()
                    if not line:
                        continue
                    if (line.startswith("workspace>>") or 
                        line.startswith("activewindowv2>>") or 
                        line.startswith("closewindow>>") or 
                        line.startswith("fullscreen>>")):
                        time.sleep(0.04)
                        sync_bar_state()
            sock.close()
        except Exception as e:
            log(f"socket2_sync_listener reconnecting in 2s: {e}")
            time.sleep(2)

def main():
    sys.stdout.reconfigure(line_buffering=True)
    with open("/tmp/gesture_debug.log", "w") as f:
        f.write("=== Touchpad Gestures Daemon Started ===\n")

    # Start the workspace/fullscreen bar synchronization thread
    t = threading.Thread(target=socket2_sync_listener, daemon=True)
    t.start()

    try:
        proc = subprocess.Popen(
            ["stdbuf", "-oL", "libinput", "debug-events"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1
        )
        log("Started libinput debug-events with stdbuf successfully.")
    except Exception as e:
        log(f"Failed to start libinput debug-events: {e}")
        sys.exit(1)

    accumulated_dx = 0.0
    last_trigger = 0.0
    v5_mode = os.environ.get("NOCTALIA_SESSION") == "v5"
    threshold = 2.0 if v5_mode else 30.0
    cooldown = 0.05

    swipe_total_dx = 0.0
    swipe_total_dy = 0.0
    swipe_direction = "undecided"

    swipe_update_re = re.compile(
        r'GESTURE_SWIPE_UPDATE\s+(?:\d+\s+)?\+?[\d\.]+s\s+(\d+)\s+([-\d.]+)\s*/\s*([-\d.]+)'
    )
    fallback_re = re.compile(r'dx:\s*([-\d.]+).*dy:\s*([-\d.]+)')

    for line in iter(proc.stdout.readline, ''):
        line_str = line.strip()

        if "GESTURE_SWIPE_BEGIN" in line:
            swipe_total_dx = 0.0
            swipe_total_dy = 0.0
            swipe_direction = "undecided"
            accumulated_dx = 0.0
            continue
            
        if "GESTURE_SWIPE_END" in line:
            swipe_total_dx = 0.0
            swipe_total_dy = 0.0
            swipe_direction = "undecided"
            accumulated_dx = 0.0
            continue

        if "GESTURE_SWIPE_UPDATE" in line:
            fingers = 0
            dx = 0.0
            dy = 0.0
            
            m = swipe_update_re.search(line)
            if m:
                fingers = int(m.group(1))
                dx = float(m.group(2))
                dy = float(m.group(3))
            else:
                m_fb = fallback_re.search(line)
                if m_fb:
                    f_m = re.search(r'\s([345])\s', line)
                    if f_m:
                        fingers = int(f_m.group(1))
                    dx = float(m_fb.group(1))
                    dy = float(m_fb.group(2))

            if fingers == 3:
                swipe_total_dx += dx
                swipe_total_dy += dy
                
                if swipe_direction == "undecided":
                    dist_x = abs(swipe_total_dx)
                    dist_y = abs(swipe_total_dy)
                    if dist_x >= 6.0 or dist_y >= 6.0:
                        if dist_x > dist_y * 1.5:
                            swipe_direction = "horizontal"
                        elif dist_y > dist_x * 1.5:
                            swipe_direction = "vertical"
                        else:
                            if dist_x >= 12.0 or dist_y >= 12.0:
                                swipe_direction = "horizontal" if dist_x > dist_y else "vertical"

                if swipe_direction == "horizontal":
                    accumulated_dx += dx
                    now = time.time()
                    if (now - last_trigger) >= cooldown:
                        if accumulated_dx >= threshold:
                            adjust_volume("up")
                            accumulated_dx = 0.0
                            last_trigger = now
                        elif accumulated_dx <= -threshold:
                            adjust_volume("down")
                            accumulated_dx = 0.0
                            last_trigger = now

if __name__ == "__main__":
    main()
