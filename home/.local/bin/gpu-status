#!/bin/bash
echo "=== GPU Status Report ==="
echo ""
echo "--- Current Optimus Mode ---"
~/.local/bin/envycontrol --query 2>/dev/null || envycontrol --query 2>/dev/null

echo ""
echo "--- NVIDIA GPU Usage ---"
nvidia-smi --query-gpu=name,driver_version,temperature.gpu,utilization.gpu,utilization.memory,memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | awk -F',' '{printf "GPU: %s\nDriver: %s\nTemp: %s°C\nGPU Util: %s%%\nMem Util: %s%%\nMem Used: %s/%s MiB\n", $1,$2,$3,$4,$5,$6,$7}'

echo ""
echo "--- Active GPU Processes ---"
nvidia-smi pmon -c 1 2>/dev/null | grep -v "^#" | grep -v "No running" || echo "No processes using GPU"

echo ""
echo "--- Display GPU ---"
switcherooctl list 2>/dev/null | grep -E 'Name:|Default:'
