#!/usr/bin/env bash
# noctalia-switch — swap the active Noctalia profile between v4 and v5.
#
# Usage:
#   noctalia-switch v4     # activate Noctalia v4 profile
#   noctalia-switch v5     # activate Noctalia v5 (main) profile
#   noctalia-switch status # show which profile is currently active
#
# How it works:
#   v5 configs always live at  ~/.config/noctalia/        (canonical live dir)
#   v4 configs always live at  ~/.config/noctalia-v4/     (isolated store)
#
#   "Activating" v4 = snapshot the live v5 dir to ~/.config/noctalia-v5-snapshot/,
#                     then copy v4 configs over ~/.config/noctalia/.
#   "Activating" v5 = copy the v5-snapshot (or noctalia-v5 backup) back to
#                     ~/.config/noctalia/.
#
#   A small marker file ~/.config/noctalia/.profile_version tracks the active version.

set -euo pipefail

NOCTALIA_LIVE="$HOME/.config/noctalia"
NOCTALIA_V4="$HOME/.config/noctalia-v4"
NOCTALIA_V5_SNAP="$HOME/.config/noctalia-v5-snapshot"
MARKER="$NOCTALIA_LIVE/.profile_version"

say()  { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!! %s\033[0m\n' "$*"; }
die()  { printf '\033[1;31m## %s\033[0m\n' "$*" >&2; exit 1; }

current_version() {
  if [ -f "$MARKER" ]; then
    cat "$MARKER"
  else
    echo "v5"   # assume v5 if marker is absent (default state)
  fi
}

show_status() {
  local ver
  ver="$(current_version)"
  echo -e "\033[1;36mActive Noctalia profile:\033[0m  \033[1;33m$ver\033[0m"
  echo ""
  echo "  ~/.config/noctalia/         ← live (currently: $ver)"
  if [ -d "$NOCTALIA_V4" ]; then
    echo "  ~/.config/noctalia-v4/      ← v4 isolated store  ✓"
  else
    echo "  ~/.config/noctalia-v4/      ← v4 isolated store  (not present)"
  fi
  if [ -d "$NOCTALIA_V5_SNAP" ]; then
    echo "  ~/.config/noctalia-v5-snapshot/  ← v5 snapshot  ✓"
  else
    echo "  ~/.config/noctalia-v5-snapshot/  ← v5 snapshot  (not yet created)"
  fi
}

activate_v4() {
  local cur
  cur="$(current_version)"

  if [ "$cur" = "v4" ]; then
    echo "Already on v4. Nothing to do."
    return 0
  fi

  say "Switching to Noctalia v4..."

  # 1. Ensure v4 store exists
  [ -d "$NOCTALIA_V4" ] || die "v4 config store not found at $NOCTALIA_V4.
Run install.sh from the noctalia-v4 branch first, or copy your v4 configs there."

  # 2. Snapshot the current live (v5) configs before overwriting
  say "  Snapshotting current v5 configs → $NOCTALIA_V5_SNAP"
  rsync -a --delete \
    --exclude='shell.log' \
    --exclude='*.log' \
    --exclude='pinned_clipboard.json' \
    --exclude='.profile_version' \
    "$NOCTALIA_LIVE/" "$NOCTALIA_V5_SNAP/"

  # 3. Copy v4 configs over the live dir
  say "  Copying v4 configs → $NOCTALIA_LIVE"
  rsync -a --delete \
    --exclude='shell.log' \
    --exclude='*.log' \
    --exclude='pinned_clipboard.json' \
    "$NOCTALIA_V4/" "$NOCTALIA_LIVE/"

  # 4. Write profile marker
  echo "v4" > "$MARKER"

  say "Done. Active profile: v4"
  _reload_shell
}

activate_v5() {
  local cur
  cur="$(current_version)"

  if [ "$cur" = "v5" ]; then
    echo "Already on v5. Nothing to do."
    return 0
  fi

  say "Switching to Noctalia v5..."

  # 1. Save any changes made while on v4 back into the v4 store
  say "  Saving current v4 state → $NOCTALIA_V4"
  rsync -a \
    --exclude='shell.log' \
    --exclude='*.log' \
    --exclude='pinned_clipboard.json' \
    --exclude='.profile_version' \
    "$NOCTALIA_LIVE/" "$NOCTALIA_V4/"

  # 2. Restore the v5 snapshot (or fallback to the live dir as-is)
  if [ -d "$NOCTALIA_V5_SNAP" ]; then
    say "  Restoring v5 snapshot → $NOCTALIA_LIVE"
    rsync -a --delete \
      --exclude='shell.log' \
      --exclude='*.log' \
      --exclude='pinned_clipboard.json' \
      "$NOCTALIA_V5_SNAP/" "$NOCTALIA_LIVE/"
  else
    warn "No v5 snapshot found. The live dir will keep its current state."
    warn "Run 'noctalia-switch v4' and then 'noctalia-switch v5' to create the snapshot."
  fi

  # 3. Write profile marker
  echo "v5" > "$MARKER"

  say "Done. Active profile: v5"
  _reload_shell
}

_reload_shell() {
  # Attempt to reload the Noctalia/Quickshell session so the UI picks up changes.
  # Non-fatal — user can reload manually if this fails.
  if command -v quickshell >/dev/null && pgrep -x quickshell >/dev/null 2>&1; then
    say "  Reloading Quickshell/Noctalia shell..."
    quickshell reload 2>/dev/null || pkill -HUP quickshell 2>/dev/null || warn "Could not reload quickshell automatically. Run it manually."
  elif pgrep -x noctalia >/dev/null 2>&1; then
    pkill -HUP noctalia 2>/dev/null || warn "Could not send HUP to noctalia. Reload manually."
  else
    warn "Noctalia/Quickshell does not appear to be running. Start a session to see the new profile."
  fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
TARGET="${1:-}"
case "$TARGET" in
  v4)     activate_v4 ;;
  v5)     activate_v5 ;;
  status) show_status ;;
  "")
    echo "Usage: noctalia-switch <v4|v5|status>"
    echo ""
    show_status
    ;;
  *)
    die "Unknown target '$TARGET'. Use: v4 | v5 | status"
    ;;
esac
