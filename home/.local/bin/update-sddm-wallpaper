#!/bin/bash
# update-sddm-wallpaper — syncs the active Noctalia wallpaper to SDDM
# Reads the actual current wallpaper from Noctalia's own state file.

WALLPAPERS_JSON="$HOME/.cache/noctalia/wallpapers.json"
TARGET="/etc/sddm/noctalia-bg"

# Get the current wallpaper path from Noctalia's state
# Prefers primary display (eDP-1), falls back to first available
CURRENT=$(python3 -c "
import json, sys
try:
    d = json.load(open('$WALLPAPERS_JSON'))
    walls = d.get('wallpapers', {})
    # prefer built-in display eDP-1, else first monitor
    for monitor in ['eDP-1', 'DP-1', 'DP-2', 'HDMI-A-1']:
        if monitor in walls:
            path = walls[monitor].get('dark') or walls[monitor].get('light', '')
            if path:
                print(path)
                sys.exit(0)
    # fallback: first monitor found
    for v in walls.values():
        p = v.get('dark') or v.get('light', '')
        if p:
            print(p)
            sys.exit(0)
except Exception as e:
    sys.exit(1)
" 2>/dev/null)

if [ -z "$CURRENT" ] || [ ! -f "$CURRENT" ]; then
    echo "update-sddm-wallpaper: could not read current wallpaper from $WALLPAPERS_JSON" >&2
    exit 1
fi

sudo cp -f "$CURRENT" "$TARGET"
echo "SDDM wallpaper → $(basename "$CURRENT")"
