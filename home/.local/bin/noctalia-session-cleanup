#!/usr/bin/env bash
# noctalia-session-cleanup — runs at session startup
# If the current session is NOT Hyprland, evict all prewarmed Noctalia files from kernel memory.

LOG="$HOME/.local/state/prewarm-apps.log"
mkdir -p "$(dirname "$LOG")"

CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-}"

if [[ "${CURRENT_DESKTOP,,}" != *"hyprland"* ]]; then
    echo "$(date -Is) [cleanup] Non-Hyprland session detected ($CURRENT_DESKTOP). Evicting prewarmed Noctalia assets..." >> "$LOG"
    
    if command -v vmtouch >/dev/null; then
        # Evict quickshell QML files
        vmtouch -e /etc/xdg/quickshell/noctalia-shell >/dev/null 2>&1
        
        # Evict user noctalia configs
        vmtouch -e "$HOME/.config/noctalia" >/dev/null 2>&1
        
        # Evict top prewarmed app directories to completely free page cache
        STATE="$HOME/.cache/noctalia/shell-state.json"
        if [ -r "$STATE" ]; then
            # Get same top-N directories and evict them
            python3 - "$STATE" <<'PY' | while read -r path; do vmtouch -e "$path" >/dev/null 2>&1; done
import json, sys
try:
    u = json.load(open(sys.argv[1])).get('launcherUsage', {})
except Exception:
    sys.exit(0)
items = [(v.get('count', 0) if isinstance(v, dict) else int(v), k) for k, v in u.items()]
items.sort(reverse=True)
for _, k in items[:6]:
    # Output typical install directory to evict
    if k.startswith('/opt/'):
        print('/opt/' + k.split('/')[2])
    elif k.startswith('/usr/share/'):
        print('/usr/share/' + k.split('/')[3])
PY
        fi
        echo "$(date -Is) [cleanup] Eviction complete." >> "$LOG"
    else
        echo "$(date -Is) [cleanup] vmtouch not found. Skipping eviction." >> "$LOG"
    fi
fi
