#!/usr/bin/env python3
import sys
import os
import json
import re
import subprocess
import argparse
from datetime import datetime, timedelta

try:
    from rich.console import Console
    from rich.panel import Panel
    from rich.table import Table
    from rich.text import Text
    from rich import box
    RICH_AVAILABLE = True
except ImportError:
    RICH_AVAILABLE = False

def check_dependencies():
    missing = []
    for cmd in ["vnstat", "tuptime"]:
        if not shutil_which(cmd):
            missing.append(cmd)
    return missing

def shutil_which(cmd):
    for path in os.environ.get("PATH", "").split(os.pathsep):
        full_path = os.path.join(path, cmd)
        if os.path.isfile(full_path) and os.access(full_path, os.X_OK):
            return full_path
    return None

def format_bytes(bytes_num):
    for unit in ['B', 'KiB', 'MiB', 'GiB', 'TiB']:
        if bytes_num < 1024.0:
            return f"{bytes_num:.2f} {unit}"
        bytes_num /= 1024.0
    return f"{bytes_num:.2f} PiB"

def get_default_interface():
    try:
        res = subprocess.run(["ip", "route", "show", "default"], capture_output=True, text=True, check=True)
        lines = res.stdout.strip().split('\n')
        if lines:
            parts = lines[0].split()
            if "dev" in parts:
                idx = parts.index("dev")
                if idx + 1 < len(parts):
                    return parts[idx + 1]
    except Exception:
        pass
    return None

def get_vnstat_interfaces():
    try:
        res = subprocess.run(["vnstat", "--json"], capture_output=True, text=True)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            return [iface['name'] for iface in data.get('interfaces', [])]
    except Exception:
        pass
    return []

def get_vnstat_totals(interface):
    """Extract Total Usage for Today, This Month, and Highest Ever Daily."""
    try:
        res = subprocess.run(["vnstat", "--json", "-i", interface], capture_output=True, text=True, check=True)
        data = json.loads(res.stdout)
        interfaces_data = data.get("interfaces", [])
        if not interfaces_data:
            return None
        
        iface_data = interfaces_data[0]
        traffic = iface_data.get("traffic", {})
        
        today = datetime.now().date()
        current_year = today.year
        current_month = today.month
        
        today_total = 0
        days_list = traffic.get("day", []) or traffic.get("days", [])
        for d in days_list:
            d_info = d.get("date", {})
            if d_info.get("year") == current_year and d_info.get("month") == current_month and d_info.get("day") == today.day:
                today_total = d.get("rx", 0) + d.get("tx", 0)
                break
                
        month_total = 0
        months_list = traffic.get("month", []) or traffic.get("months", [])
        for m in months_list:
            m_info = m.get("date", {})
            if m_info.get("year") == current_year and m_info.get("month") == current_month:
                month_total = m.get("rx", 0) + m.get("tx", 0)
                break
                
        highest_total = 0
        top_list = traffic.get("top", [])
        if top_list:
            top_item = max(top_list, key=lambda x: (x.get("rx", 0) + x.get("tx", 0)))
            highest_total = top_item.get("rx", 0) + top_item.get("tx", 0)
            
        return {
            "today": today_total,
            "month": month_total,
            "highest": highest_total
        }
    except Exception as e:
        return f"Error running vnstat: {e}"

def parse_tuptime_regex(output_str):
    parsed = {}
    for line in output_str.split('\n'):
        line = line.strip()
        if not line:
            continue
            
        m_longest = re.match(r"Longest uptime:\s+(.*?)\s+from\s+(.*)", line, re.IGNORECASE)
        if m_longest:
            parsed["longest_duration"] = m_longest.group(1).strip()
            parsed["longest_date"] = m_longest.group(2).strip()
            continue

        m_current = re.match(r"Current uptime:\s+(.*?)\s+since\s+(.*)", line, re.IGNORECASE)
        if m_current:
            parsed["current_duration"] = m_current.group(1).strip()
            parsed["current_date"] = m_current.group(2).strip()
            continue

        m_startups = re.match(r"System startups:\s+(\d+)\s+since\s+(.*)", line, re.IGNORECASE)
        if m_startups:
            parsed["startups_count"] = m_startups.group(1).strip()
            parsed["startups_since"] = m_startups.group(2).strip()
            continue

        m_shutdowns = re.match(r"System shutdowns:\s+(.*)", line, re.IGNORECASE)
        if m_shutdowns:
            parsed["shutdowns"] = m_shutdowns.group(1).strip()
            continue

        m_avg = re.match(r"Average uptime:\s+(.*)", line, re.IGNORECASE)
        if m_avg:
            parsed["average"] = m_avg.group(1).strip()
            continue

        m_uptime = re.match(r"System uptime:\s+([\d\.]+%\s+=\s+.*)", line, re.IGNORECASE)
        if m_uptime:
            parsed["system_uptime"] = m_uptime.group(1).strip()
            pct_match = re.search(r"([\d\.]+)%", line)
            if pct_match:
                parsed["system_uptime_pct"] = float(pct_match.group(1))
            continue
            
    return parsed

def format_short_dt(dt_str):
    try:
        dt = datetime.strptime(dt_str, "%m/%d/%Y %I:%M:%S %p")
        today = datetime.now().date()
        if dt.date() == today:
            return dt.strftime("%I:%M %p")
        else:
            return dt.strftime("%b %d")
    except Exception:
        return dt_str

def get_system_intervals(since_epoch, until_epoch):
    cmd = ["tuptime", "--tsince", str(since_epoch), "--tuntil", str(until_epoch), "-l", "-s"]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode != 0:
            return []
        
        intervals = []
        lines = res.stdout.strip().split('\n')
        current_startup = None
        
        for line in lines:
            line = line.strip()
            if not line:
                continue
            
            if line.startswith("Startup:"):
                parts = line.split()
                if "at" in parts:
                    idx = parts.index("at")
                    if idx + 1 < len(parts):
                        current_startup = int(parts[idx + 1])
                else:
                    current_startup = since_epoch
            elif line.startswith("Uptime:"):
                parts = line.split()
                if len(parts) >= 2 and current_startup is not None:
                    uptime = int(parts[1])
                    intervals.append((current_startup, current_startup + uptime))
                current_startup = None
                
        return intervals
    except Exception:
        return []

def get_lock_intervals(since_epoch, until_epoch, system_intervals):
    log_path = "/home/ldzbeta/.local/state/sys-stats-lock.log"
    if not os.path.exists(log_path):
        return 0
        
    events = []
    try:
        with open(log_path, "r") as f:
            for line in f:
                parts = line.strip().split()
                if len(parts) == 2:
                    try:
                        ts = int(parts[0])
                        evt = parts[1].lower()
                        if evt in ('lock', 'unlock'):
                            events.append((ts, evt))
                    except ValueError:
                        continue
    except Exception:
        return 0
        
    if not events:
        return 0
        
    events.sort(key=lambda x: x[0])
    total_locked_seconds = 0
    
    for sys_start, sys_end in system_intervals:
        sys_events = [e for e in events if sys_start <= e[0] <= sys_end]
        is_locked = False
        lock_start = None
        
        for ts, evt in sys_events:
            if evt == 'lock':
                if not is_locked:
                    is_locked = True
                    lock_start = ts
            elif evt == 'unlock':
                if is_locked:
                    t_start = max(lock_start, since_epoch)
                    t_end = min(ts, until_epoch)
                    if t_start < t_end:
                        total_locked_seconds += (t_end - t_start)
                    is_locked = False
                    lock_start = None
                    
        if is_locked and lock_start is not None:
            t_start = max(lock_start, since_epoch)
            t_end = min(sys_end, until_epoch)
            if t_start < t_end:
                total_locked_seconds += (t_end - t_start)
                
    return total_locked_seconds

def make_compact_bar(val, max_val, max_len=8, color="bright_green"):
    if max_val <= 0:
        pct = 0.0
    else:
        pct = min(1.0, max(0.0, val / max_val))
    filled = int(round(pct * max_len))
    bar = "█" * filled + "░" * (max_len - filled)
    return f"[{color}]{bar}[/{color}] {pct*100:4.1f}%"

def get_weekly_usage():
    today = datetime.now().date()
    weekly_entries = []
    
    for i in range(6, -1, -1):
        day = today - timedelta(days=i)
        s_dt = datetime(day.year, day.month, day.day, 0, 0, 0)
        e_dt = datetime(day.year, day.month, day.day, 23, 59, 59)
        s_epoch = int(s_dt.timestamp())
        e_epoch = int(e_dt.timestamp())
        
        intervals = get_system_intervals(s_epoch, e_epoch)
        total_up = sum(e - s for s, e in intervals)
        locked_sec = get_lock_intervals(s_epoch, e_epoch, intervals)
        active_sec = max(0, total_up - locked_sec)
        
        weekly_entries.append({
            "date": day,
            "total_up": total_up,
            "active_sec": active_sec,
            "locked_sec": locked_sec
        })
        
    return weekly_entries

def render_btop_ui(interface, net_stats, tuptime_lifetime, tuptime_period, weekly_entries):
    console = Console()
    
    # 1. Header
    header_text = Text()
    header_text.append(" 󰌢 ", style="bold bright_green")
    header_text.append("SYSTEM USAGE & NETWORK DASHBOARD", style="bold white")
    header_text.append(f"  │  {interface}", style="dim white")
    header_text.append(f"  │  {datetime.now().strftime('%b %d, %I:%M %p')}", style="dim white")

    console.print(Panel(header_text, box=box.ROUNDED, border_style="bright_green", padding=(0, 1)))

    # 2. Network Table (ONLY Total Usage - 2 Columns)
    net_table = Table(box=box.ROUNDED, show_header=True, header_style="bold bright_cyan", border_style="cyan", expand=True)
    net_table.add_column("Network Period", style="bold white")
    net_table.add_column("Total Traffic", style="bold green", justify="right")

    if isinstance(net_stats, dict):
        net_table.add_row("󰅐 Today's Usage", f"[bold yellow]{format_bytes(net_stats['today'])}[/bold yellow]")
        net_table.add_row("󰸗 This Month's Usage", f"[bold green]{format_bytes(net_stats['month'])}[/bold green]")
        net_table.add_row("󰓅 Highest Ever Daily", f"[bold bright_cyan]{format_bytes(net_stats['highest'])}[/bold bright_cyan]")
    else:
        net_table.add_row("Status", f"[bold red]{net_stats}[/bold red]")

    console.print(Panel(net_table, title="[bold bright_cyan] Network Traffic Summary [/bold bright_cyan]", box=box.ROUNDED, border_style="cyan"))

    # 3. Responsive Weekly Usage Chart
    if weekly_entries:
        week_table = Table(box=box.SIMPLE_HEAD, show_header=True, header_style="bold bright_green", border_style="dim green", expand=True)
        week_table.add_column("Date", style="bold white")
        week_table.add_column("Active Hours", style="bold bright_green")
        week_table.add_column("Uptime", style="bright_green", justify="right")
        week_table.add_column("Locked", style="yellow", justify="right")

        for entry in weekly_entries:
            d_str = entry["date"].strftime("%b %d (%a)")
            act_sec = entry["active_sec"]
            bar = make_compact_bar(act_sec, 24 * 3600, max_len=8, color="bright_green")
            
            h = act_sec // 3600
            m = (act_sec % 3600) // 60
            up_h = entry["total_up"] // 3600
            up_m = (entry["total_up"] % 3600) // 60
            loc_h = entry["locked_sec"] // 3600
            loc_m = (entry["locked_sec"] % 3600) // 60

            week_table.add_row(
                d_str,
                f"{bar} {h}h {m:02d}m",
                f"{up_h}h {up_m:02d}m",
                f"{loc_h}h {loc_m:02d}m" if loc_h > 0 else f"{loc_m}m"
            )

        console.print(Panel(week_table, title="[bold bright_green] 󰨖 This Week System Usage & Active Hours [/bold bright_green]", box=box.ROUNDED, border_style="bright_green"))

    # 4. System Analytics Bottom Box (Minimal 2 Columns: Metric & Value/Duration)
    sys_table = Table(box=box.ROUNDED, show_header=True, header_style="bold yellow", border_style="yellow", expand=True)
    sys_table.add_column("System Metric", style="bold white")
    sys_table.add_column("Value / Duration", style="bold green", justify="right")

    if "current_duration" in tuptime_lifetime:
        curr_dur = tuptime_lifetime["current_duration"]
        curr_dt = format_short_dt(tuptime_lifetime.get("current_date", ""))
        sys_table.add_row("󱎫 Current Session", f"{curr_dur} (Started {curr_dt})")

    if weekly_entries:
        today_entry = weekly_entries[-1]
        t_act_h = today_entry["active_sec"] // 3600
        t_act_m = (today_entry["active_sec"] % 3600) // 60
        t_up_h = today_entry["total_up"] // 3600
        t_up_m = (today_entry["total_up"] % 3600) // 60
        sys_table.add_row("󰔟 Today's Active / Uptime", f"{t_act_h}h {t_act_m:02d}m active / {t_up_h}h {t_up_m:02d}m uptime")

    if "longest_duration" in tuptime_period:
        p_dur = tuptime_period["longest_duration"]
        p_dt = format_short_dt(tuptime_period.get("longest_date", ""))
        sys_table.add_row("󰨖 Longest Session Per Day", f"{p_dur} ({p_dt})")

    if "longest_duration" in tuptime_lifetime:
        long_dur = tuptime_lifetime["longest_duration"]
        long_dt = format_short_dt(tuptime_lifetime.get("longest_date", ""))
        sys_table.add_row("󰓅 Longest Session Ever", f"[bold bright_magenta]{long_dur}[/bold bright_magenta] ({long_dt})")

    if "system_uptime" in tuptime_lifetime:
        sys_table.add_row("󰌢 Lifetime System Uptime", tuptime_lifetime["system_uptime"])

    console.print(Panel(sys_table, title="[bold yellow] 󰔟 System Session Analytics [/bold yellow]", box=box.ROUNDED, border_style="yellow"))

def render_plain_ui(interface, net_stats, tuptime_lifetime, tuptime_period):
    print("=" * 65)
    print("       SYSTEM USAGE & NETWORK DASHBOARD")
    print("=" * 65)
    
    print(f"\n[+] Network Usage (Interface: {interface})")
    if isinstance(net_stats, dict):
        print(f"  - Today's Usage:         {format_bytes(net_stats['today'])}")
        print(f"  - This Month's Usage:    {format_bytes(net_stats['month'])}")
        print(f"  - Highest Ever Daily:    {format_bytes(net_stats['highest'])}")
    else:
        print(f"  [-] Network statistics query failed: {net_stats}")
        
    print(f"\n[+] System Session Analytics")
    if "current_duration" in tuptime_lifetime:
        print(f"  - Current Uptime Session:  {tuptime_lifetime['current_duration']} (Started {format_short_dt(tuptime_lifetime.get('current_date', ''))})")
    if "longest_duration" in tuptime_lifetime:
        print(f"  - Longest Session Ever:    {tuptime_lifetime['longest_duration']} (Started {format_short_dt(tuptime_lifetime.get('longest_date', ''))})")
    if "average" in tuptime_lifetime:
        print(f"  - Average Session Length:  {tuptime_lifetime['average']}")

def main():
    parser = argparse.ArgumentParser(
        description="System Network Usage & System Uptime Analytics Dashboard (btop++ TUI).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  %(prog)s                               # Run btop++ TUI dashboard
  %(prog)s --plain                       # Output in plain text format
  %(prog)s -i wlan0                      # Specify network interface
"""
    )
    parser.add_argument("-s", "--start", default="7d", help="Start date. Default: 7d")
    parser.add_argument("-e", "--end", default="today", help="End date. Default: today")
    parser.add_argument("-i", "--interface", help="Network interface. Auto-detected if omitted.")
    parser.add_argument("--plain", action="store_true", help="Output plain text instead of btop++ TUI dashboard.")
    
    args = parser.parse_args()
    
    missing = check_dependencies()
    if missing:
        print("[-] Missing required system packages:", ", ".join(missing), file=sys.stderr)
        sys.exit(1)
        
    interface = args.interface
    if not interface:
        interface = get_default_interface()
        tracked = get_vnstat_interfaces()
        if interface and interface not in tracked:
            if tracked:
                interface = tracked[0]
        elif not interface and tracked:
            interface = tracked[0]
            
    if not interface:
        print("[-] Error: No network interfaces detected or tracked by vnstat.", file=sys.stderr)
        sys.exit(1)
        
    net_stats = get_vnstat_totals(interface)
    
    lifetime_tuptime_out = subprocess.run(["tuptime"], capture_output=True, text=True).stdout
    tuptime_lifetime = parse_tuptime_regex(lifetime_tuptime_out)
    
    tuptime_period = {}
    try:
        from_d = datetime.now().date() - timedelta(days=7)
        s_epoch = int(datetime(from_d.year, from_d.month, from_d.day, 0, 0, 0).timestamp())
        e_epoch = int(datetime.now().timestamp())
        period_out = subprocess.run(["tuptime", "--tsince", str(s_epoch), "--tuntil", str(e_epoch)], capture_output=True, text=True).stdout
        tuptime_period = parse_tuptime_regex(period_out)
    except Exception:
        pass
        
    weekly_entries = get_weekly_usage()

    if args.plain or not RICH_AVAILABLE:
        render_plain_ui(interface, net_stats, tuptime_lifetime, tuptime_period)
    else:
        render_btop_ui(interface, net_stats, tuptime_lifetime, tuptime_period, weekly_entries)

if __name__ == "__main__":
    main()
