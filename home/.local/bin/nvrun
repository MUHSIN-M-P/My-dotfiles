#!/usr/bin/env bash
# nvrun — Launch applications on the NVIDIA discrete GPU (Prime Offload)

export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only

# Support DRI_PRIME offloading for open-source Mesa / NVK / Nouveau drivers
export DRI_PRIME=1

echo "Launching: $* on Dedicated GPU"
exec "$@"
